# Copy to `.env` (git-ignored, never commit real values).
# Server / API variables. Needed from Phase 2 (auth) and Phase 3 (DB) onward.

# Postgres connection string (Phase 3: Supabase → Project Settings → Database)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres

# Supabase project URL (Phase 2+)
SUPABASE_URL=https://YOUR_REF.supabase.co

# Supabase JWT secret — API server verifies auth tokens with this (Phase 2+)
# Supabase → Project Settings → API Keys → JWT Secret
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET

# Stripe test-mode secret key (Phase 4+)
STRIPE_SECRET_KEY=sk_test_YOUR_KEY

# Stripe webhook signing secret (Phase 4+, after deploy exposes a public URL)
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET

# API server port (defaults apply if unset, but be explicit in production)
PORT=5000
