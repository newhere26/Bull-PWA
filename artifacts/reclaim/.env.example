# Copy to `.env` (git-ignored, never commit real values).
# Frontend variables — all must start with VITE_ to reach the browser.
# Needed from Phase 2 (auth) onward.

# Supabase project URL + anon public key (Supabase → Project Settings → API Keys)
VITE_SUPABASE_URL=https://YOUR_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Where the browser reaches the API. Local dev default (same-origin in prod):
VITE_API_URL=http://localhost:5000
